<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <Description>This contains the distributable library to invoke methods on available Security Micro Services</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>Alkami.MicroServices.Security.Service.Client.$(MediumNameSuffix)</AssemblyName>
    <RootNamespace>Alkami.MicroServices.Security.Service.Client</RootNamespace>
    <PackageId>Alkami.MicroServices.Security.Client</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <VersionPrefix>$(MediumNameVersionPrefix)</VersionPrefix>
    <Configurations>Debug;Release;k8s</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alkami.GlobalAssets" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.LibraryAssets" Version="1.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.Subscription.ParticipatingClient" Version="5.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alkami.MicroServices.Security.Contracts\Alkami.MicroServices.Security.Contracts.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\Alkami.MicroServices.Security.Data.Validations\Alkami.MicroServices.Security.Data.Validations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(ProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>