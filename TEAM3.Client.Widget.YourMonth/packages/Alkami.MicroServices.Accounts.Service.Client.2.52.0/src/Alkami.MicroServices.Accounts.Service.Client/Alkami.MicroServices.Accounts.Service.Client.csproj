<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <Description>Proxy Class for the Accounts Microservice</Description>
    <PackageProjectUrl>https://extranet.alkamitech.com/display/ORB/Alkami.MicroServices.Accounts.Service.Client</PackageProjectUrl>
    <RepositoryUrl>https://extranet.alkamitech.com/display/ORB/Alkami.MicroServices.Accounts.Service.Client</RepositoryUrl>
    <PackageTags>ORB Microservices Accounts Client</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>Alkami.MicroServices.Accounts.Service.Client.$(MediumNameSuffix)</AssemblyName>
    <RootNamespace>Alkami.MicroServices.Accounts.Service.Client</RootNamespace>
    <PackageId>Alkami.MicroServices.Accounts.Service.Client</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <VersionPrefix>$(MediumNameVersionPrefix)</VersionPrefix>
    <Configurations>Debug;Release;k8s</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alkami.GlobalAssets" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.LibraryAssets" Version="1.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alkami.Subscription.ParticipatingClient" Version="5.3.0" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(ProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
	<ProjectReference Include="..\Alkami.MicroServices.Accounts.Contracts\Alkami.MicroServices.Accounts.Contracts.csproj" />
	<ProjectReference Include="..\Alkami.MicroServices.Accounts.Data.Validations\Alkami.MicroServices.Accounts.Data.Validations.csproj">
		<PrivateAssets>all</PrivateAssets>
	</ProjectReference>
    <ProjectReference Include="..\Alkami.MicroServices.Accounts.Data\Alkami.MicroServices.Accounts.Data.csproj">
		<PrivateAssets>all</PrivateAssets>
	</ProjectReference>
  </ItemGroup>
</Project>