@using Alkami.Client.WebClient.Shared.Helpers
@using System.Web.Mvc.Html
@using Alkami.Client.Framework.Utility
@model TEAM3.Client.Widget.YourMonth.Models.TEAM3YourMonthModel
@section TitleContentPlaceholder{
    @Html.SiteText("Title")
}

@section StyleSheetContentPlaceholder{
    @Html.CssWithCacheExpiration("/Areas/TEAM3YourMonth/Styles/yourmonth.css")
}

@section JavaScriptIncludeContentPlaceholder{
    @Html.ScriptWithCacheExpiration("~/lib/chartjs/chart.min.js")
    @Html.ScriptWithCacheExpiration("~/lib/vue/vue.min.js")
    @Html.ScriptWithCacheExpiration("~/lib/vue-demi/index.iife.js")
    @Html.ScriptWithCacheExpiration("~/lib/pinia/pinia.iife.prod.js")
    <script>
        window.team3YourMonthText = {
            loading: '@Html.SiteText("Loading")',
            dismiss: '@Html.SiteText("Dismiss")',
            spendHeading: '@Html.SiteText("SpendHeading")',
            thisMonth: '@Html.SiteText("ThisMonth")',
            lastMonth: '@Html.SiteText("LastMonth")',
            change: '@Html.SiteText("Change")',
            topMerchants: '@Html.SiteText("TopMerchants")',
            recurringCharges: '@Html.SiteText("RecurringCharges")',
            noData: '@Html.SiteText("NoData")',
            genericError: '@Html.SiteText("GenericError")',
            chartLabel: '@Html.SiteText("ChartLabel")',
            budgetBar: '@Html.SiteText("BudgetBar")',
            budgetRemaining: '@Html.SiteText("BudgetRemaining")',
            totalOverDays: '@Html.SiteText("TotalOverDays")',
            budgetOf: '@Html.SiteText("BudgetOf")',
            categoryHeading: '@Html.SiteText("CategoryHeading")',
            insightsTab: '@Html.SiteText("InsightsTab")',
            tabsLabel: '@Html.SiteText("Title")',
            budgetSpent: '@Html.SiteText("BudgetSpent")',
            budgetAmount: '@Html.SiteText("BudgetAmount")',
            save: '@Html.SiteText("Save")',
            budgetsSaved: '@Html.SiteText("BudgetsSaved")',
            budgetRemove: '@Html.SiteText("BudgetRemove")',
            budgetAddCategory: '@Html.SiteText("BudgetAddCategory")',
            budgetAdd: '@Html.SiteText("BudgetAdd")'
        };
    </script>
    @Html.ScriptWithCacheExpiration("~/Areas/TEAM3YourMonth/Scripts/yourmonth.js")
}

<div class="widget yourmonth-widget">
    <div class="content pad--base">
        <div class="flex flex-justify--between flex-align--center yourmonth-greeting">
            <h2 class="font-medium-heading mar-bottom--0">@Html.SiteText("Greeting"), @Model.FirstName</h2>
            <button id="yourmonth_settings_button" type="button" class="iris-button iris-button--ghost" data-modifier="compressed" aria-label="@Html.SiteText("BudgetSettings")" aria-controls="yourmonth_budget_drawer">
                <span class="font-icon-budget-tools" aria-hidden="true"></span>
            </button>
        </div>
        <div id="app"></div>
    </div>
</div>

<div class="iris-drawer" id="yourmonth_budget_drawer" aria-hidden="true">
    <section class="iris-drawer__content">
        <header class="iris-drawer__header">
            <h2 class="iris-drawer__title">@Html.SiteText("BudgetDrawerTitle")</h2>
            <button class="iris-button iris-button--ghost" data-modifier="compressed" data-close aria-label="@Html.SiteText("Close")">
                <span class="font-icon-cancel-x" aria-hidden="true"></span>
            </button>
        </header>
        <div class="iris-drawer__body pad--base">
            <p class="yourmonth-budget__intro">@Html.SiteText("BudgetDrawerText")</p>
            <div id="yourmonth_budget_app"></div>
        </div>
        <footer class="iris-drawer__footer">
            <button id="yourmonth_budget_save" class="iris-button iris-button--primary mar-bottom--md" data-size="full-width" type="button">
                <span class="iris-button__text">@Html.SiteText("Save")</span>
            </button>
            <button class="iris-button iris-button--secondary" data-close data-size="full-width" type="button">
                <span class="iris-button__text">@Html.SiteText("Close")</span>
            </button>
        </footer>
    </section>
</div>
